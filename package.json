{
  "name": "pm-operator",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:e2e": "pnpm --filter @pm-operator/web test:e2e",
    "test:unit": "pnpm --filter @pm-operator/web test:unit",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.3",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "next": "^16.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
